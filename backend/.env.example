# Runtime
APP_ENV=development
AUTO_CREATE_SCHEMA=true
DATABASE_URL=sqlite:///./var/staypet.db
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./var/media
PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:8000/api/v1/media
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000
GENERATION_PROVIDER=mock
WORKER_POLL_SECONDS=1.0
WORKER_RETRY_BASE_SECONDS=2.0
POC_API_TOKEN=replace-with-a-local-development-token

# Supabase server-only values. Never expose these to the frontend.
# Set AUTO_CREATE_SCHEMA=false after applying the SQL migration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=staypet-assets

# OpenAI server-only values. Required only when GENERATION_PROVIDER=openai.
OPENAI_API_KEY=replace-with-server-only-api-key
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high
OPENAI_TIMEOUT_SECONDS=180

# Mock-only controls
MOCK_GENERATION_DELAY_MS=50
MOCK_FAIL_FIRST_ATTEMPT=false
